# Vercel Deployment Environment Variables
# Copy these to Vercel project settings and fill in actual values

# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-change-this
ALLOWED_HOSTS=your-project-name.vercel.app,your-custom-domain.com

# Database - Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require&channel_binding=require

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Configuration - Gmail
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# CORS
CORS_ALLOWED_ORIGINS=https://your-project-name.vercel.app,https://your-custom-domain.com

# Feature Flags
FACE_RECOGNITION_ENABLED=False
LIVENESS_ENABLED=False
