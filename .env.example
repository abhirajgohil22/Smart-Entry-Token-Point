# Django Settings
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SECRET_KEY=change-me-in-production-use-strong-random-key

# Database Configuration
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/campus_tokens
# Or SQLite for development (default)
# DATABASE_URL=sqlite:///db.sqlite3

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# AWS / S3 Configuration
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=campus-photos-dev
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT=http://localhost:9000  # MinIO for local development
AWS_KMS_MASTER_KEY_ID=arn:aws:kms:us-east-1:ACCOUNT:key/xxxxx

# Feature Flags - Face Recognition
# Set to True to enable optional face recognition feature
FACE_RECOGNITION_ENABLED=False

# Feature Flags - Liveness Detection
# Only relevant if FACE_RECOGNITION_ENABLED=True
LIVENESS_ENABLED=False

# Face Recognition Backend (if enabled)
# Options: 'dlib', 'deepface', 'aws_rekognition'
FACE_RECOGNITION_BACKEND=dlib

# Google OAuth2
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend  # For development
SENDGRID_API_KEY=your-sendgrid-key

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Security
SECURE_SSL_REDIRECT=False  # Set to True in production
SESSION_COOKIE_SECURE=False  # Set to True in production
CSRF_COOKIE_SECURE=False  # Set to True in production
